# macOS Build, Sign & Notarize
# Copy to .env.signing and fill in (do not commit .env.signing).
# Then: source .env.signing && ./build-mac-sign-notarize.sh

# App Store Connect API Key (for notarytool)
# Issuer ID from App Store Connect → Users and Access → Keys
export APPLE_ISSUER_ID="43676244-5284-4124-9444-1a4f7417265a"
# Key ID from the key name (e.g. AuthKey_PR88795KN9.p8 → PR88795KN9)
export APPLE_KEY_ID="2T937M8983"
# Full path to the .p8 key file downloaded from App Store Connect
export APPLE_API_KEY_PATH="/path/to/AuthKey_2T937M8983.p8"

# Developer ID Application certificate name (from Keychain)
# Find with: security find-identity -v -p codesigning
export SIGN_IDENTITY="Developer ID Application: Jeremy Wang (9Z2389Q5T7)"
